# API image: build the workspace crate, then ship a tiny runtime.
# syntax=docker/dockerfile:1

FROM rust:1.99-bookworm AS builder
WORKDIR /src

# The whole workspace is needed: Cargo resolves every member manifest, and
# `sqlx::migrate!` embeds `migrations/` at compile time.
COPY . .
RUN cargo build --release --locked -p nenchess-api

FROM debian:bookworm-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/target/release/nenchess-api /usr/local/bin/nenchess-api

ENV BIND_ADDR=0.0.0.0:8080 \
    RUST_LOG=info

EXPOSE 8080
USER nobody
ENTRYPOINT ["/usr/local/bin/nenchess-api"]
