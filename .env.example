# --- Backend (services/api) ---
DATABASE_URL=postgres://nenchess:nenchess@localhost:5432/nenchess
BIND_ADDR=127.0.0.1:8080
RUST_LOG=info,nenchess_api=debug
# OUTBOX_POLL_INTERVAL_MS=200
# SESSION_TTL_DAYS=14
# DATABASE_MAX_CONNECTIONS=10

# --- Hardening (0 = disabled) ---
# RATE_LIMIT_AUTH_PER_MINUTE=30   # register + login per client IP
# RATE_LIMIT_API_PER_MINUTE=0     # authenticated API calls per user
# RATE_LIMIT_WS_PER_MINUTE=120    # WebSocket commands per connection
# COOKIE_SECURE=false             # true behind HTTPS (adds `Secure`)
# TRUST_PROXY_HEADERS=false       # true behind nginx (X-Real-IP / X-Forwarded-For)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Frontend (apps/web) ---
# VITE_API_BASE_URL=/api   (default: same origin, proxied by Vite in dev)
